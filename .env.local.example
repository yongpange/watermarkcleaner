# ============================================================================
# CREEM支付配置
# ============================================================================
# 从 https://dashboard.creem.io 获取
# 必填：Creem API Key
CREEM_API_KEY=

# 必填：Creem Webhook签名密钥
# Dashboard → Settings → Webhooks → Signing Secret
CREEM_SIGNING_SECRET=

# 必填：Creem环境
# 测试环境：sandbox
# 生产环境：production
CREEM_ENVIRONMENT=sandbox

# 必填：Creem产品ID映射（JSON格式）
# Dashboard → Products → 复制Product ID
# 格式：{"pro-monthly": "prod_xxxxx", "basic-monthly": "prod_yyyyy"}
CREEM_PRODUCT_IDS={"pro-monthly":"prod_xxxxx"}

# 启用Creem支付
CREEM_ENABLED=true

# ============================================================================
# STRIPE支付配置（可选）
# ============================================================================
# STRIPE_ENABLED=false
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_SIGNING_SECRET=
# STRIPE_PAYMENT_METHODS=["card"]
# STRIPE_ALLOW_PROMOTION_CODES=true

# ============================================================================
# PAYPAL支付配置（可选）
# ============================================================================
# PAYPAL_ENABLED=false
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# PAYPAL_ENVIRONMENT=sandbox

# ============================================================================
# 默认支付提供商配置
# ============================================================================
# 可选：creem, stripe, paypal
DEFAULT_PAYMENT_PROVIDER=creem

# ============================================================================
# 支付回调URL配置
# ============================================================================
# 支付成功后的重定向页面
NEXT_PUBLIC_PAY_SUCCESS_URL=http://localhost:3000/my-orders

# 支付失败后的重定向页面
NEXT_PUBLIC_PAY_FAIL_URL=http://localhost:3000/#pricing

# 用户取消支付后的重定向页面
NEXT_PUBLIC_PAY_CANCEL_URL=http://localhost:3000/#pricing

# ============================================================================
# 数据库配置
# ============================================================================
# Supabase URL和密钥
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ============================================================================
# IP地址哈希盐值（32字节随机值）
# ============================================================================
# 用于IP地址匿名化，确保安全
# 生成命令：openssl rand -hex 32
IP_HASH_SALT=

# ============================================================================
# 应用配置
# ============================================================================
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# ============================================================================
# 其他配置
# ============================================================================
# 日志级别
LOG_LEVEL=info

# 启用详细日志
DEBUG_PAYMENT_WEBHOOK=true
