# -----------------------------------------------------------------------------
# Security Configuration
# -----------------------------------------------------------------------------
# IP Hash Salt - 用于匿名化IP地址（生成一次，不要修改）
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT = "your-32-byte-hex-salt-here-change-this-in-production"

# Admin API Key - 用于管理接口（生成强密码）
ADMIN_API_KEY = "your-super-secret-admin-key-min-32-chars"

# Data Retention Policy - 数据保留天数（默认3天）
DATA_RETENTION_DAYS = "3"

# Privacy Notice
# IP地址会被加盐哈希处理后存储，用于防止服务滥用
# 原始IP地址不会被存储，哈希后的标识符在72小时后自动删除
