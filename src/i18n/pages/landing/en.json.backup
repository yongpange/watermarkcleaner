  "faq": {
    "name": "faq",
    "label": "FAQ",
    "title": "Frequently Asked Questions",
    "description": "Everything you need to know about WatermarkCleaner",
    "items": [
      {
        "title": "Is WatermarkCleaner really free?",
        "description": "Yes! WatermarkCleaner offers free watermark removal with no sign-up required. You can process images instantly without any cost. We also offer premium plans for users who need advanced features like batch processing and higher resolution outputs."
      },
      {
        "title": "What image formats are supported?",
        "description": "WatermarkCleaner supports all major image formats including JPG, JPEG, PNG, WebP, and BMP. You can upload images up to 20MB in size. The output format matches your input, or you can choose to convert between formats."
      },
      {
        "title": "Will removing watermarks lower image quality?",
        "description": "No! Our AI technology is designed to preserve the original image quality. Unlike basic tools that blur or distort the image, WatermarkCleaner intelligently fills the removed area with matching content, maintaining sharpness and resolution."
      },
      {
        "title": "Can I use WatermarkCleaner on mobile devices?",
        "description": "Absolutely! WatermarkCleaner is fully responsive and works on any device - smartphones, tablets, and desktops. No app installation required - just visit our website and start removing watermarks."
      },
      {
        "title": "What if the watermark is on a complex background?",
        "description": "Our AI excels at handling complex backgrounds! It analyzes the surrounding area and intelligently reconstructs the image beneath the watermark. For best results with very complex areas, use our brush tool to precisely mark the watermark."
      },
      {
        "title": "Is my data secure and private?",
        "description": "Absolutely. Your images are processed securely and automatically deleted from our servers after processing. We never store, share, or use your images for any other purpose. Your privacy is our priority."
      },
      {
        "title": "Can I remove watermarks from multiple images at once?",
        "description": "Yes! With our batch processing feature, you can upload and process multiple images simultaneously. This is perfect for cleaning up large collections of photos efficiently."
      },
      {
        "title": "Is it legal to remove watermarks?",
        "description": "WatermarkCleaner is a tool for legitimate use cases like removing your own watermarks, cleaning personal photos, or removing distracting elements. Please respect copyright laws and only remove watermarks from images you own or have permission to edit."
      }
    ]
  },
